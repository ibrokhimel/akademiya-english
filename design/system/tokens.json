{
  "$comment": "Akademiya shared design system, v1 (2026-10-23). One file for Akademiya English and Akademiya Math. Sizes are in design points at a 390-wide phone.",
  "font": {
    "family": "Nunito",
    "weights": { "body": 700, "strong": 800, "heavy": 900 }
  },
  "type": {
    "display": { "size": 34, "line": 40, "weight": 900 },
    "title": { "size": 26, "line": 32, "weight": 900 },
    "heading": { "size": 20, "line": 26, "weight": 900 },
    "body": { "size": 16, "line": 23, "weight": 700 },
    "small": { "size": 14, "line": 20, "weight": 700 },
    "label": { "size": 12, "line": 16, "weight": 900, "letterSpacing": 0.8, "uppercase": true },
    "button": { "size": 16, "line": 22, "weight": 900, "letterSpacing": 0.6, "uppercase": true }
  },
  "color": {
    "app": {
      "english": { "main": "#7B5CFF", "lip": "#5A3FD9", "wash": "#EFEBFF", "washLine": "#C9BDFF" },
      "math": { "main": "#2E7CF6", "lip": "#1F5CC9", "wash": "#E8F0FE", "washLine": "#CFDDF8" }
    },
    "light": {
      "ink": "#14161B",
      "muted": "#6B6F7B",
      "faint": "#9A9DA8",
      "line": "#E6E7EB",
      "lineLip": "#CDD0D7",
      "paper": "#F4F5F7",
      "surface": "#FFFFFF",
      "reward": "#FFCB2E",
      "rewardLip": "#E0A800",
      "rewardWash": "#FFF6D1",
      "rewardText": "#9A6A00",
      "correct": "#1DB45A",
      "correctLip": "#14904A",
      "correctWash": "#E3F6EA",
      "correctText": "#13813F",
      "notYet": "#F29D0C",
      "notYetWash": "#FFF1DC",
      "notYetText": "#A35F00",
      "danger": "#E5394A"
    },
    "dark": {
      "ink": "#F4F4F6",
      "muted": "#A3A5B2",
      "faint": "#6A6C78",
      "line": "#2E2F37",
      "lineLip": "#202127",
      "paper": "#1B1C22",
      "surface": "#121318",
      "reward": "#FFCB2E",
      "rewardLip": "#B88A00",
      "rewardWash": "#2F2812",
      "rewardText": "#FFCB2E",
      "correct": "#2BC56A",
      "correctLip": "#17904B",
      "correctWash": "#14321F",
      "correctText": "#5BD98E",
      "notYet": "#F5A623",
      "notYetWash": "#33240F",
      "notYetText": "#FFC266",
      "danger": "#FF5A6A"
    }
  },
  "radius": { "button": 16, "card": 20, "tile": 24, "pill": 999 },
  "lip": { "button": 4, "tile": 4, "pathNode": 9 },
  "space": [4, 8, 12, 16, 20, 24, 32, 40],
  "motion": {
    "springs": {
      "gentle": { "mass": 1, "stiffness": 170, "damping": 18 },
      "snappy": { "mass": 1, "stiffness": 520, "damping": 26 },
      "bouncy": { "mass": 1, "stiffness": 380, "damping": 13 }
    },
    "staggerMs": 45
  }
}
