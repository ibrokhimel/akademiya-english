{
  "expo": {
    "name": "Akademiya English",
    "slug": "akademiya-english",
    "scheme": "akademiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "./plugins/withAndroidNdk",
      "./plugins/withAndroidBack",
      "./plugins/withAndroidReleaseSigning",
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 293,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#121214"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ],
          "microphonePermission": "Gapirish mashqlari uchun mikrofon kerak."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../../pendev/icons-r2/glyph-bell-white.png",
          "color": "#7B5CFF"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.akademiya.english",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "ai.akademiya.english",
      "adaptiveIcon": {
        "backgroundColor": "#7B5CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 2,
      "allowBackup": false,
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
