  "exercises": [
    {
      "id": "E1",
      "activity": "Picture Talk",
      "title": "Meet It",
      "does": "Listen first: picture + Uzbek/Russian meaning + audio, no text. Repeat what you heard; text appears in feedback (\"Stuck? Show the text\" link).",
      "ladder": "Intro"
    },
    {
      "id": "E2",
      "activity": "Picture Talk",
      "title": "Say What You See",
      "does": "A task in Uzbek/Russian (\"You want coffee. Tell the waiter.\") + picture → say the English phrase. Hint shows only the first words.",
      "ladder": "Recall"
    },
    {
      "id": "E3",
      "activity": "Picture Talk",
      "title": "Match Rush",
      "does": "4 sound buttons (🔊 1–4) ↔ 4 phrases against the clock. Silent mode: Uzbek/Russian ↔ English.",
      "ladder": "Recognise"
    },
    {
      "id": "E4",
      "activity": "Build the Sentence",
      "title": "Tile Builder",
      "does": "Uzbek/Russian sentence → build English from tiles (with 2 distractors) → optional read-aloud.",
      "ladder": "Rebuild"
    },
    {
      "id": "E5",
      "activity": "Build the Sentence",
      "title": "Complete the Chunk",
      "does": "Picture cue + phrase with a gap → pick from 3 (only one correct English form).",
      "ladder": "Recognise"
    },
    {
      "id": "E6",
      "activity": "Overheard",
      "title": "What Happened?",
      "does": "Conversation plays with no text → one question with 3 picture answers → transcript appears.",
      "ladder": "Recognise"
    },
    {
      "id": "E7",
      "activity": "Overheard",
      "title": "Who Said It?",
      "does": "Conversation plays → \"Who said '…'?\" → Waiter / Customer.",
      "ladder": "Recognise"
    },
    {
      "id": "E8",
      "activity": "Overheard",
      "title": "Missing Word",
      "does": "Hear the sentence → type the 1 missing word (numbers accepted as digits too). Silent: choose from 3.",
      "ladder": "Recall"
    },
    {
      "id": "E9",
      "activity": "Echo",
      "title": "Echo Line",
      "does": "Character says a line → repeat right after → each word green/orange; tap orange to hear it.",
      "ladder": "Recall"
    },
    {
      "id": "E10",
      "activity": "Sound Duel",
      "title": "Which One?",
      "does": "Fast rounds: hear \"ship\" or \"sheep\" → tap it (8 rounds). Needs sound.",
      "ladder": "Recognise"
    },
    {
      "id": "E11",
      "activity": "Sound Duel",
      "title": "Say Both",
      "does": "Say both words of a minimal pair so they sound different.",
      "ladder": "Recall"
    },
    {
      "id": "E12",
      "activity": "Spot the Rule",
      "title": "Find the Pattern",
      "does": "4 examples → guess the rule → 2-line Uzbek/Russian confirmation.",
      "ladder": "Notice"
    },
    {
      "id": "E13",
      "activity": "Fix It",
      "title": "Tap the Mistake",
      "does": "Context line (Uzbek/Russian) + sentence with one typical mistake → tap the wrong word. \"Tap the gap\" mode (added 2026-10-09): for missing words, tap the gap where a word is missing.",
      "ladder": "Recognise"
    },
    {
      "id": "E14",
      "activity": "Fix It",
      "title": "Fix & Say",
      "does": "Context line + wrong sentence → say the corrected sentence.",
      "ladder": "Recall"
    },
    {
      "id": "E15",
      "activity": "Quick Reply",
      "title": "Guided Reply",
      "does": "Waiter's question → choose a reply → say it → waiter reacts.",
      "ladder": "Use"
    },
    {
      "id": "E16",
      "activity": "Quick Reply",
      "title": "Free Reply",
      "does": "Say anything to the waiter; AI reacts and corrects by recasting. Ends with 🙂 / 😄 / 🤩.",
      "ladder": "Use"
    }
  ],
  "lessons": [
    {
      "number": 1,
      "skill": "GREET someone",
      "uzbek": "Endi siz salomlasha olasiz",
      "phrases": "Hello! · Hi! · Good morning!",
      "reuses": "—",
      "trap": "—"
    },
    {
      "number": 2,
      "skill": "SAY YOUR NAME",
      "uzbek": "O'zingizni tanishtira olasiz",
      "phrases": "I'm Aziz. · My name is Malika. · What's your name?",
      "reuses": "Hello, Hi",
      "trap": "\"I Aziz\" (missing am)"
    },
    {
      "number": 3,
      "skill": "SAY WHERE YOU'RE FROM",
      "uzbek": "Qayerdan ekaningizni ayta olasiz",
      "phrases": "I'm from Uzbekistan. · I'm from Tashkent. · Where are you from?",
      "reuses": "I'm…, What's your name?",
      "trap": "\"I from Tashkent\""
    },
    {
      "number": 4,
      "skill": "ASK HOW SOMEONE IS",
      "uzbek": "Hol-ahvol so'ray olasiz",
      "phrases": "How are you? · I'm fine, thank you. · I'm good. And you?",
      "reuses": "Hello, I'm…",
      "trap": "\"I fine\""
    },
    {
      "number": 5,
      "skill": "SAY GOODBYE",
      "uzbek": "Xayrlasha olasiz",
      "phrases": "Nice to meet you. · Goodbye! · See you!",
      "reuses": "All of Unit 1",
      "trap": "—"
    },
    {
      "number": 6,
      "skill": "ORDER A DRINK",
      "uzbek": "Ichimlik buyurtma qila olasiz",
      "phrases": "A coffee, please. · A tea, please. · An orange juice, please.",
      "reuses": "Hello, thank you",
      "trap": "a / an"
    },
    {
      "number": 7,
      "skill": "ORDER FOOD",
      "uzbek": "Taom buyurtma qila olasiz",
      "phrases": "Can I have a sandwich? · I'd like a samsa, please. · A salad, please.",
      "reuses": "A … please",
      "trap": "a / an"
    },
    {
      "number": 8,
      "skill": "ASK THE PRICE",
      "uzbek": "Narxini so'ray olasiz",
      "phrases": "How much is it? · It's ten thousand som. · numbers 1–20 + thousand",
      "reuses": "coffee, tea, samsa",
      "trap": "\"two coffee\" → two coffees"
    },
    {
      "number": 9,
      "skill": "SAY WHAT YOU DON'T WANT",
      "uzbek": "Nimani xohlamasligingizni ayta olasiz",
      "phrases": "No sugar, please. · No, thank you. · Just water, please.",
      "reuses": "coffee, tea, please",
      "trap": "\"I no want\""
    },
    {
      "number": 10,
      "skill": "PAY AND SAY THANKS",
      "uzbek": "To'lab, rahmat ayta olasiz",
      "phrases": "Can I pay by card? · Here you are. · Thank you! Goodbye!",
      "reuses": "How much…, numbers, Goodbye",
      "trap": "\"Thanks you\" → Thank you"
    },
    {
      "number": 11,
      "skill": "ASK IF THEY HAVE SOMETHING",
      "uzbek": "Kerakli narsani so'ray olasiz",
      "phrases": "Do you have water? · Yes, we do. · No, sorry.",
      "reuses": "water, please",
      "trap": "\"You have water?\" (question word order)"
    },
    {
      "number": 12,
      "skill": "ASK ABOUT THIS AND THAT",
      "uzbek": "\"Bu\" va \"u\"ning narxini so'ray olasiz",
      "phrases": "How much is this? · How much is that? · This one, please.",
      "reuses": "How much is it?, numbers",
      "trap": "\"How much this?\" (missing is)"
    },
    {
      "number": 13,
      "skill": "CHOOSE A COLOUR",
      "uzbek": "Rang tanlay olasiz",
      "phrases": "A red T-shirt, please. · Do you have it in blue? · I like this colour.",
      "reuses": "Do you have…?, This one",
      "trap": "a / an before colours"
    },
    {
      "number": 14,
      "skill": "ASK FOR A SIZE",
      "uzbek": "O'lcham so'ray olasiz",
      "phrases": "Small, medium or large? · It's too big. · Do you have a small one?",
      "reuses": "Do you have…?, colours",
      "trap": "\"very big\" vs too big"
    },
    {
      "number": 15,
      "skill": "BUY IT",
      "uzbek": "Xarid qila olasiz",
      "phrases": "I'll take it. · That's forty-five thousand. · numbers to 100",
      "reuses": "How much…, Can I pay by card?, Thank you",
      "trap": "fifteen vs fifty (listening)"
    }
  ],
  "traps": [
    {
      "id": "T1",
      "name": "Missing \"am\"",
      "mistake": "I Aziz · I from Tashkent · I fine",
      "correct": "I'm Aziz",
      "lessons": "2, 3, 4",
      "explanation": "O'zbek tilida «-man» qo'shimchasi bor: Men Azizman. Ingliz tilida u alohida so'z — am: I am Aziz → I'm Aziz."
    },
    {
      "id": "T2",
      "name": "a / an",
      "mistake": "A orange juice · Coffee, please",
      "correct": "An orange juice · A coffee",
      "lessons": "6, 7, 13",
      "explanation": "O'zbek tilida artikl yo'q. Bitta narsa oldidan a qo'yiladi: a coffee. So'z unli tovush bilan boshlansa — an: an orange juice."
    },
    {
      "id": "T3",
      "name": "Plural after numbers",
      "mistake": "Two coffee",
      "correct": "Two coffees",
      "lessons": "8",
      "explanation": "O'zbekchada «ikkita qahva» deymiz. Ingliz tilida birdan ko'p bo'lsa -s qo'shiladi: two coffees."
    },
    {
      "id": "T4",
      "name": "\"no\" for negation",
      "mistake": "I no want sugar",
      "correct": "I don't want sugar / No sugar, please",
      "lessons": "9",
      "explanation": "O'zbekchada inkor fe'lga qo'shiladi: xohlamayman. Ingliz tilida don't ishlatiladi: I don't want sugar. Qisqasi: No sugar, please."
    },
    {
      "id": "T5",
      "name": "Thanks you",
      "mistake": "Thanks you!",
      "correct": "Thank you! / Thanks!",
      "lessons": "10",
      "explanation": "Thank you yoki Thanks deymiz. Thanks you — ikkalasini aralashtirmang."
    },
    {
      "id": "T6",
      "name": "Question without \"Do\"",
      "mistake": "You have water?",
      "correct": "Do you have water?",
      "lessons": "11",
      "explanation": "O'zbekchada savol «-mi» bilan yasaladi: Sizda suv bormi? Ingliz tilida savol boshiga Do qo'yiladi: Do you have water?"
    },
    {
      "id": "T7",
      "name": "Missing \"is\"",
      "mistake": "How much this?",
      "correct": "How much is this?",
      "lessons": "12",
      "explanation": "O'zbekchada «Bu qancha?» deymiz — fe'lsiz. Ingliz tilida is kerak: How much is this?"
    },
    {
      "id": "T8",
      "name": "very vs too",
      "mistake": "It's very big (\"doesn't fit\")",
      "correct": "It's too big",
      "lessons": "14",
      "explanation": "O'zbekchada «juda katta» ikki ma'noda. Ingliz tilida: very big — juda katta; too big — haddan tashqari katta, to'g'ri kelmaydi."
    },
    {
      "id": "T9",
      "name": "fifteen vs fifty (listening)",
      "mistake": "Hears 50 instead of 15",
      "correct": "fifTEEN / FIFty",
      "lessons": "15",
      "explanation": "fifTEEN (15) — urg'u oxirida, cho'ziq «iː». FIFty (50) — urg'u boshida."
    }
  ],
